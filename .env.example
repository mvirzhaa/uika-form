# --- Dasar ---
PORT=8080
BASE_URL=https://form.uika-bogor.ac.id        # alamat publik (dipakai untuk QR sertifikat & redirect OIDC)
NODE_ENV=production
SESSION_SECRET=ganti-dengan-string-acak-panjang   # openssl rand -hex 32
TRUST_PROXY=1                                  # jumlah proxy di depan aplikasi (nginx = 1)
RATE_LIMIT_PER_MIN=300
ORG_NAME=Universitas Ibn Khaldun Bogor

# --- PostgreSQL ---
DATABASE_URL=postgres://uikaform:uikaform@db:5432/uikaform

# --- Login E-Portal UIKA (SSO Introspect) ---
SSO_ENABLED=true
SSO_BASE_URL=https://eportal.uika-bogor.ac.id/eportal-api/api
EPORTAL_URL=https://eportal.uika-bogor.ac.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_APP_MODULE_ID=

# --- Login E-Portal OIDC (Opsional / Alternatif) ---
# Daftarkan redirect URI:  {BASE_URL}/auth/callback
OIDC_ISSUER=https://eportal.uika-bogor.ac.id
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_ID_CLAIM=preferred_username               # klaim berisi NIM/NIP

# --- Peran ---
ADMIN_EMAILS=admin@uika-bogor.ac.id            # dipisah koma; otomatis admin saat login
DEFAULT_ROLE=creator                           # creator = boleh membuat form; user = hanya mengisi

# --- Email sertifikat (opsional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=UIKA Form <no-reply@uika-bogor.ac.id>

# Hanya untuk pengembangan lokal (DILARANG di produksi):
# DEV_LOGIN=true
